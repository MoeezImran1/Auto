{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/(app\\.js)", "dest": "/frontend/app.js" },
    { "src": "/(style\\.css)", "dest": "/frontend/style.css" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
